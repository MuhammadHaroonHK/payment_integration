# --- PayLab backend configuration ------------------------------------------
# Copy this file to ".env" and adjust the values for your machine.
#
# ⚠️ SECURITY
# This file is committed to git, so it must NEVER contain a real merchant
# secret, password or signing key. Only public or local values belong here.
# Real credentials belong in server/.env, which is git-ignored, or in the
# environment variables of the hosting platform.

# "development" | "test" | "production"
NODE_ENV=development

# Port the Express server listens on.
PORT=5000

# The only origin allowed to call this API from a browser (the Vite dev server).
CLIENT_URL=http://localhost:5173

# Public origin of THIS API, as seen by the payment gateway.
# The gateway redirects the customer's browser here, so localhost works for
# local development. For an IPN or a portal that needs a public URL, expose the
# API with an HTTPS tunnel (for example `ngrok http 5000`) and put that URL
# here. No trailing slash.
PUBLIC_BASE_URL=http://localhost:5000

# Local MongoDB connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/paylab

# "mock" — the local simulator, no provider is contacted (default).
# "live" — real JazzCash / Easypaisa hosted checkout.
# Live mode refuses a gateway whose credentials below are missing, but the
# server itself still starts.
PAYMENT_MODE=mock

# Development-only controls that let you force a transaction outcome
# (SUCCESS / FAILED / CANCELLED / PENDING).
# They are ignored unless NODE_ENV=development AND PAYMENT_MODE=mock.
ENABLE_TEST_CONTROLS=true

# How long the simulated gateway call takes, in milliseconds.
MOCK_GATEWAY_DELAY_MS=600

# "fatal" | "error" | "warn" | "info" | "debug" | "trace"
LOG_LEVEL=info

# --- JazzCash hosted checkout ------------------------------------------------
# Credentials come from the JazzCash merchant portal. Keep them server side.
# "sandbox" uses sandbox.jazzcash.com.pk, "production" uses payments.jazzcash.com.pk.
JAZZCASH_ENVIRONMENT=sandbox
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
# Optional: "" lets the customer choose | MWALLET | MPAY | OTC
JAZZCASH_TXN_TYPE=
# Optional: override the return URL registered with JazzCash.
JAZZCASH_RETURN_URL=

# --- Easypaisa hosted checkout ----------------------------------------------
# Store id and hash key come from the Easypay merchant portal. The hash key is
# exactly 16, 24 or 32 characters. The username / password / account number
# are optional; when present they are used to verify a payment with the
# inquiry API instead of trusting the unsigned redirect.
EASYPAISA_ENVIRONMENT=sandbox
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=
EASYPAISA_ACCOUNT_NUMBER=
# Optional: "" lets the customer choose | MA_PAYMENT_METHOD | OTC_PAYMENT_METHOD | CC_PAYMENT_METHOD
EASYPAISA_PAYMENT_METHOD=
# Optional: override the return URL registered with Easypaisa.
EASYPAISA_RETURN_URL=
# Easypaisa's final redirect is NOT signed. Set this to "true" only when the
# inquiry credentials above are unavailable. A SUCCESS result from the redirect
# is then accepted and stored with gatewayVerified=false.
# "false" (the code default) keeps a SUCCESS result PENDING until verification.
EASYPAISA_TRUST_REDIRECT=true

# --- Optional -----------------------------------------------------------------
# A separate database used by the automated tests. When it is not set the
# tests use MONGODB_URI with the database name "paylab_test".
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/paylab_test
