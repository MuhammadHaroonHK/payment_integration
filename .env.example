# --- PayLab frontend environment configuration --------------------------------
# Copy this file to ".env" and adjust the values if needed.
#
# WARNING: every variable that starts with VITE_ is embedded in the browser
# bundle and is therefore PUBLIC. Never put merchant credentials, signing
# keys, API secrets, PINs or OTPs in this file. Real payment credentials
# belong on the backend only.

# Base URL of the PayLab backend API.
# Start the backend with:  cd server && npm run dev
VITE_API_BASE_URL=http://localhost:5000/api

# Which payment implementation the frontend uses:
#   mock    -> the built-in browser simulator, no server needed (fully offline)
#   backend -> real HTTP calls to VITE_API_BASE_URL (the Express + MongoDB API)
VITE_PAYMENT_MODE=backend
